<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep user work restorable, but exclude personal voice recordings. -->
        <exclude domain="file" path="voice_samples/" />
        <!-- Do not restore Firebase Auth session after reinstall. -->
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Apply the same privacy boundary during phone-to-phone transfer. -->
        <exclude domain="file" path="voice_samples/" />
    </device-transfer>
</data-extraction-rules>
